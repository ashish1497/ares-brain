# --- Required to start ---

# Paste a fresh refresh_token from the LMS (DevTools > Application > Cookies > refresh_token).
# It rotates on every use; the scraper rewrites this line automatically after each run.
MESA_REFRESH_TOKEN=

# Long-lived token for HEADLESS `claude -p` calls — the dashboard's Chat/Testprep/
# Mock-midterm "Generate" buttons, and the 6 AM/6 PM launchd jobs, all spawn `claude -p`
# as a subprocess and need this to authenticate (the desktop app's own login does NOT
# cover a separate `claude` binary on PATH). Generate one with:
#   claude setup-token
# and paste the printed value here.
CLAUDE_CODE_OAUTH_TOKEN=

# --- Optional ---

# A freshly-copied 15-minute access token, skips one refresh.
MESA_ACCESS_TOKEN=

# ARES_BRAIN_HOME=/absolute/path/to/ares-brain
# MESA_TERM_ID=

# Gemini key(s) for transcription (scraper/transcribe.py) — GOOGLE_GEMINI_KEY is tried
# first, then _2, _3, ... in order, as a rotation set if one hits a rate limit. Only
# needed if you're transcribing class recordings.
GOOGLE_GEMINI_KEY=
GOOGLE_GEMINI_KEY_2=
GOOGLE_GEMINI_KEY_3=

# GEMINI_MODEL=gemini-3.6-flash
