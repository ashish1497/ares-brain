# Paste a fresh refresh_token from the LMS (DevTools > Application > Cookies > refresh_token).
# It rotates on every use; the scraper rewrites this line automatically after each run.
MESA_REFRESH_TOKEN=

# Optional: a freshly-copied 15-minute access token, skips one refresh.
MESA_ACCESS_TOKEN=

# Optional overrides.
# ARES_BRAIN_HOME=/absolute/path/to/ares-brain
# MESA_TERM_ID=

GOOGLE_GEMINI_KEY=
GOOGLE_GEMINI_KEY_2=
GOOGLE_GEMINI_KEY_3=
